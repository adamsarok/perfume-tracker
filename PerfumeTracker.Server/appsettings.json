{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Session": {
    "IdleTimeoutHours": 24,
    "AbsoluteLifetimeHours": 336
  },
  "RateLimits": {
    "General": 250,
    "Auth": 50,
    "Upload": 25
  },
  "Users": {
    "AdminUserName": "admin",
    "AdminEmail": "admin@example.com",
    "DemoUserName": "demo",
    "DemoEmail": "demo@example.com",
    "InviteOnlyRegistration": true,
  },
  "R2": {
    "BucketName": "test",
    "ExpirationHours": 24,
    "MaxFileSizeKb": 256
  },
  "CORS": {
    "AllowedOrigins": [ "http://localhost:3000", "https://localhost:3000", "http://192.168.1.79:3000", "https://192.168.1.79:3000" ]
  },
  "Missions": {
    "WeeklyCreateCount": 4
  },
  "OpenAI": {
    "AssistantModel": "gpt-6.1-sol",
    "EmbeddingsModel": "text-embedding-3-small"
  },
  "WeeklyDigest": {
    "MaxTokens": 150000,
    "FinalizationReserve": 40000,
    "FinalInputTokens": 15000,
    "MaxOutputTokens": 25000,
    "MaxExplorationRequests": 50,
    "MaxAttempts": 3
  },
  "ChatAgent": {
    "MaxIterations": 4,
    "MaxResultsPerToolCall": 50
  }
}
